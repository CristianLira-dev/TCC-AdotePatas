# As URLs agora usam diretórios com index.php; não há regras de reescrita.

# Página personalizada para rotas/arquivos inexistentes.
ErrorDocument 404 /erro-404/

# Bloqueia arquivos ocultos de acesso direto.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Impede acesso direto ao arquivo de conexão.
<Files "conexao.php">
    Require all denied
</Files>
